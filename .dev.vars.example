# Salin ke .dev.vars (tidak ikut di-commit). Dipakai `npm run dev` dan `wrangler dev`.
JKT48CONNECT_API_KEY=jkc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opsional: secret penanda tangan sesi & token replay (acak, ≥ 32 karakter). Bila kosong diturunkan dari API key.
# SESSION_SECRET=
# Opsional: Cloudflare Turnstile untuk pembuatan sesi. Kunci uji yang selalu lolos:
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Opsional: token admin (≥ 24 karakter) untuk `npm run guard:unblock` (buka blokir penjaga anti-iseng).
# GUARD_ADMIN_TOKEN=
# Opsional: ganti nilainya untuk mengosongkan semua blokir sekaligus.
# GUARD_EPOCH=

# Private Messages (server only; never use a VITE_ prefix)
PM_API_KEY=
MYPG_API_KEY=

# Discord dashboard (server only; see docs/discord-auth-setup.md)
DISCORD_CLIENT_ID=1305141693477027891
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/api/discord/auth/callback
DISCORD_BOT_API_URL=https://dash.jkt48connect.com/internal/discord-guild
DISCORD_BOT_API_TOKEN=
