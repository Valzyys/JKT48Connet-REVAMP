{
  "name": "jkt48connect-desktop",
  "productName": "JKT48Connect",
  "version": "1.0.0",
  "description": "Aplikasi desktop JKT48Connect: live, jadwal theater, recent, dan replay member JKT48.",
  "author": "Valzyys",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "homepage": "https://jkt48connect.app/apps",
  "scripts": {
    "start": "npm run build:ui && electron .",
    "build:ui": "vite build --config vite.config.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "icons": "python3 scripts/icons.py",
    "test": "node --test test/*.test.js",
    "dist": "npm run build:ui && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "hls.js": "1.7.3",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
