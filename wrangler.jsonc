{
  // Cloudflare Workers + Static Assets.
  // Deploy: `npm run deploy`  ·  Setup awal: `npm run cf:setup`
  "$schema": "node_modules/wrangler/config-schema.json",
  // Harus sama dengan nama Worker di dashboard Cloudflare (Workers Builds menolak nama berbeda).
  "name": "jkt48connet-revamp",
  "main": "worker/index.ts",
  // Build Vite dijalankan otomatis sebelum `wrangler deploy` / `versions upload` / `dev`,
  // jadi Workers Builds cukup memakai perintah default.
  "build": { "command": "npm run build" },
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Semua route SPA (/member/xxx, /theater/xxx, ...) dilayani index.html.
    "not_found_handling": "single-page-application",
    // /api/* selalu masuk Worker dulu (proxy ber-API key), bukan ke fallback SPA.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_UPSTREAM": "https://api.jkt48connect.app"
  },
  // Rate limit /api/* (worker/security.ts). namespace_id bebas, unik per akun.
  "ratelimits": [
    // Per sesi: semua permintaan data, gambar, dan potongan video replay.
    { "name": "API_LIMITER", "namespace_id": "4801", "simple": { "limit": 300, "period": 60 } },
    // Per IP: pembuatan sesi baru.
    { "name": "SESSION_LIMITER", "namespace_id": "4802", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": { "enabled": true }
  // Secret TIDAK ditulis di sini:
  //   npx wrangler secret put JKT48CONNECT_API_KEY
  //   npx wrangler secret put SESSION_SECRET          (opsional, disarankan; acak ≥ 32 karakter)
  //   npx wrangler secret put TURNSTILE_SECRET_KEY    (opsional; aktifkan juga VITE_TURNSTILE_SITE_KEY saat build)
}
