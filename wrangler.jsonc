{
  // Cloudflare Workers + Static Assets.
  // Deploy: `npm run deploy`  ·  Setup awal: `npm run cf:setup`
  "$schema": "node_modules/wrangler/config-schema.json",
  // Harus sama dengan nama Worker di dashboard Cloudflare (Workers Builds menolak nama berbeda).
  "name": "jkt48connet-revamp",
  "main": "worker/index.ts",
  // Build Vite dijalankan otomatis sebelum `wrangler deploy` / `versions upload` / `dev`,
  // jadi Workers Builds cukup memakai perintah default.
  "build": { "command": "npm run build" },
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Semua route SPA (/member/xxx, /theater/xxx, ...) dilayani index.html.
    "not_found_handling": "single-page-application",
    // /api/* selalu masuk Worker dulu (proxy ber-API key), bukan ke fallback SPA. Halaman SPA, robots.txt, dan
    // sitemap.xml juga lewat Worker supaya HTML awalnya membawa meta SEO per halaman (worker/seo.ts).
    "run_worker_first": [
      "/donasika", "/donasika/",
      "/api/*", "/download/*", "/robots.txt", "/sitemap.xml", "/",
      "/live", "/live/", "/theater", "/theater/*", "/schedule", "/schedule/", "/member", "/member/*",
      "/birthday", "/birthday/", "/recent", "/recent/*", "/news", "/news/*", "/video", "/video/",
      "/games", "/games/*", "/activity", "/activity/*", "/discord", "/discord/*", "/developer", "/developer/", "/apps", "/apps/", "/about", "/about/", "/disclaimer", "/disclaimer/", "/terms", "/terms/", "/privacy", "/privacy/"
    ]
  },
  "d1_databases": [{ "binding": "PM_DB", "database_name": "jkt48connect-pm", "database_id": "006d982c-707c-45e7-91e4-60801b068299", "migrations_dir": "migrations" }],
  "vars": {
    "API_UPSTREAM": "https://api.jkt48connect.app",
    // Ganti nilainya (lalu deploy) untuk mengosongkan semua poin & blokir penjaga sekaligus (worker/guard.ts).
    // 2: reset blokir salah pada pengguna APK 2.4.0 yang memanggil endpoint baru sebelum worker ter-deploy.
    "GUARD_EPOCH": "2"
  },
  // Rate limit /api/* (worker/security.ts). namespace_id bebas, unik per akun.
  "ratelimits": [
    { "name": "GAME_LIMITER", "namespace_id": "4803", "simple": { "limit": 20, "period": 60 } },
    // Per sesi: semua permintaan data, gambar, dan potongan video replay.
    { "name": "API_LIMITER", "namespace_id": "4801", "simple": { "limit": 300, "period": 60 } },
    // Per IP: pembuatan sesi baru.
    { "name": "SESSION_LIMITER", "namespace_id": "4802", "simple": { "limit": 30, "period": 60 } }
  ],
  // Penjaga anti-iseng (worker/guard-do.ts): poin curiga & blokir per IP. Dibuat otomatis saat deploy.
  // PushState (worker/push-do.ts): ID notifikasi yang sudah dikirim + token FCM untuk server push.
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "GUARD", "class_name": "Guard" },
      { "name": "PUSH", "class_name": "PushState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Guard"] },
    { "tag": "v2", "new_sqlite_classes": ["PushState"] },
    { "tag": "v3-games", "new_sqlite_classes": ["GameRoom"] }
  ],
  // Server push ke aplikasi Android: live dicek tiap 15 detik lewat alarm Durable Object (cron ini menyalakannya),
  // jadwal/ultah/berita/update tiap 10 menit.
  // Tidak berbuat apa-apa sampai secret FCM_SERVICE_ACCOUNT diatur (lihat README → Server push).
  "triggers": { "crons": ["*/2 * * * *"] },
  "observability": { "enabled": true }
  // Secret TIDAK ditulis di sini. `npm run deploy:auto` mengisinya otomatis:
  //   JKT48CONNECT_API_KEY   dari env build (wajib, sekali)
  //   SESSION_SECRET         dibuat acak bila belum ada
  //   TURNSTILE_SECRET_KEY   dari env build (opsional; pasangkan VITE_TURNSTILE_SITE_KEY)
  //   FCM_SERVICE_ACCOUNT, FCM_ANDROID_APP_ID, FCM_ANDROID_API_KEY  dari env build (opsional; server push)
}
