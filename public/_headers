# Header keamanan untuk aset statis & halaman SPA (Cloudflare Workers Static Assets / Pages).
# Respons /api/* diberi header sendiri oleh worker/security.ts.
# static.cloudflareinsights.com / cloudflareinsights.com = Cloudflare Web Analytics (beacon disisipkan Cloudflare).
# Script inline "JavaScript detections" Cloudflare (/cdn-cgi/challenge-platform) sengaja tetap diblokir: tokennya
# berubah tiap request sehingga hanya bisa diizinkan dengan 'unsafe-inline'. Matikan fitur itu di dashboard
# (Security → Bots) bila tidak dipakai.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
